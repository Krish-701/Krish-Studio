# --- Required ---
DATABASE_URL="postgresql://film:film@localhost:5432/filmstudio"

# --- Queue (optional) ---
# With REDIS_URL set, jobs go through BullMQ and live progress is fanned out over Redis pub/sub
# (run `npm run worker` alongside `npm run dev`, or set INLINE_WORKER=1 to run the worker inside Next).
# Without it, an in-process queue is used (fine for a single machine).
REDIS_URL="redis://localhost:6379"
INLINE_WORKER="1"

# --- Storage ---
# local: files go to ./storage and are served by /api/files/*
# s3:    AWS S3 or Cloudflare R2 (set S3_ENDPOINT for R2: https://<account>.r2.cloudflarestorage.com)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for the bucket (R2 public bucket / custom domain / CloudFront). If empty, presigned URLs are used.
S3_PUBLIC_URL=""

# Public URL of this app. Used so generation backends can fetch reference images by URL.
APP_URL="http://localhost:3000"

# Encrypts API keys stored in the database (any long random string).
SETTINGS_SECRET="change-me-to-a-long-random-string"

# --- Optional bootstrap (can also be set in the Settings page) ---
MAGNIFIC_MCP_URL="https://mcp.magnific.com"
# Optional: leave empty and use Settings → Connect Magnific (sign in, no token needed)
MAGNIFIC_MCP_TOKEN=""
# The agents' brain. Default: Qwen3.8 Omni Flash on OpenRouter, reasoning on, streamed.
# Put your OpenRouter key here (or in Settings). OPENROUTER_API_KEY works too.
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL="qwen/qwen3.8-omni-flash"
# "1" forces reasoning on, "0" off; empty = on for OpenRouter
LLM_REASONING=""
# Minutes between the Director's progress updates in the chat and Log tab
SUMMARY_INTERVAL_MIN="5"
# Optional model for image checks when the main model is text-only, e.g. "qwen/qwen3-vl-30b-a3b-instruct"
LLM_VISION_MODEL=""
